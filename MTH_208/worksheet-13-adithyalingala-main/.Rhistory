asia <- function(team)
{
k <- length(team)
cont <- numeric(length = k)
for(i in 1:k)
{
if( team[i]  == c("SL", "IND", "PAK", "THA", "BAN"))
{
cont[i] <- "Asia"
} else{
cont[i] <- "Not Asia"
}
}
return(cont)
}
asia(Team)
asia(dat$Team)
